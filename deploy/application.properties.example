spring.application.name=sonarfy
server.port=8080
server.forward-headers-strategy=framework
spring.datasource.url=jdbc:postgresql://db:5432/sonarfy
spring.datasource.username=sonarfy
spring.datasource.password=REPLACE_WITH_DB_PASSWORD
spring.jpa.hibernate.ddl-auto=validate
spring.jpa.show-sql=false
spring.datasource.hikari.maximum-pool-size=10
api.security.token.secret=REPLACE_WITH_RANDOM_SECRET
app.base-url=https://REPLACE_BACKEND_HOST
app.frontend-url=https://REPLACE_FRONTEND_HOST
app.cors.allowed-origins=https://REPLACE_FRONTEND_HOST
app.auth.refresh-cookie-secure=true
spring.mail.host=REPLACE_SMTP_HOST
spring.mail.port=587
spring.mail.username=REPLACE_SMTP_USERNAME
spring.mail.password=REPLACE_SMTP_PASSWORD
spring.mail.properties.mail.smtp.auth=true
spring.mail.properties.mail.smtp.starttls.enable=true
spring.mail.properties.mail.smtp.connectiontimeout=5000
spring.mail.properties.mail.smtp.timeout=5000
spring.mail.properties.mail.smtp.writetimeout=5000
SPOTIFY_CLIENT_ID=REPLACE_SPOTIFY_CLIENT_ID
SPOTIFY_CLIENT_SECRET=REPLACE_SPOTIFY_CLIENT_SECRET
SPOTIFY_REDIRECT_URI=https://REPLACE_BACKEND_HOST/api/spotify/callback
SPOTIFY_FRONTEND_REDIRECT_URI=https://REPLACE_FRONTEND_HOST
spotify_token_encryption_key=REPLACE_WITH_BASE64_32_BYTE_KEY
app.email-change.enabled=false
app.account-deactivation.enabled=false
app.avatar.enabled=false
app.wallpaper.enabled=false
