{
  "info": {
    "name": "Sonarfy - Reviews",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Contract: docs/api/reviews.md. Manual destructive lifecycle for a dedicated test account with an initially empty reviews collection and an existing local album. Set albumSpotifyId and accessToken locally. Runs create, replace and delete; do not run against personal data. No Spotify calls. Examples in contract docs; errors use existing Spring handling."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "albumSpotifyId",
      "value": ""
    },
    {
      "key": "reviewId",
      "value": ""
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Own review initially absent",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/albums/{{albumSpotifyId}}/reviews/me"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 404\", () => pm.response.to.have.status(404));"
            ]
          }
        }
      ]
    },
    {
      "name": "Create own review",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/albums/{{albumSpotifyId}}/reviews",
        "body": {
          "mode": "raw",
          "raw": "{\"rating\": 8.5, \"reviewText\": \"  Um álbum para revisitar.  \"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "pm.test(\"Review contract\", () => { const b = pm.response.json(); pm.expect(b.rating).to.eql(8.5); pm.expect(b.reviewText).to.eql(\"Um álbum para revisitar.\"); pm.expect(b.album.spotifyId).to.eql(pm.collectionVariables.get(\"albumSpotifyId\")); pm.expect(b.reviewId).to.be.a(\"number\"); pm.expect(b).not.to.have.property(\"email\"); pm.collectionVariables.set(\"reviewId\", String(b.reviewId)); });",
              "pm.test(\"No store\", () => pm.expect(pm.response.headers.get(\"Cache-Control\")).to.eql(\"no-store\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "Duplicate creation is conflict",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/albums/{{albumSpotifyId}}/reviews",
        "body": {
          "mode": "raw",
          "raw": "{\"rating\": 0}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 409\", () => pm.response.to.have.status(409));"
            ]
          }
        }
      ]
    },
    {
      "name": "Read own review",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/albums/{{albumSpotifyId}}/reviews/me"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Identity\", () => pm.expect(String(pm.response.json().reviewId)).to.eql(pm.collectionVariables.get(\"reviewId\")));"
            ]
          }
        }
      ]
    },
    {
      "name": "Reject invalid precision",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/reviews/{{reviewId}}",
        "body": {
          "mode": "raw",
          "raw": "{\"rating\": 8.25}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 400\", () => pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    },
    {
      "name": "Reject unknown album",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/albums/sonarfy-unknown-local-album/reviews",
        "body": {
          "mode": "raw",
          "raw": "{\"rating\": 8}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 404\", () => pm.response.to.have.status(404));"
            ]
          }
        }
      ]
    },
    {
      "name": "Replace and remove text",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/reviews/{{reviewId}}",
        "body": {
          "mode": "raw",
          "raw": "{\"rating\": 10, \"reviewText\": null}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Replacement\", () => { const b=pm.response.json(); pm.expect(b.rating).to.eql(10); pm.expect(b.reviewText).to.eql(null); });"
            ]
          }
        }
      ]
    },
    {
      "name": "List own collection",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/reviews/me?limit=20"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Page contract\", () => { const b=pm.response.json(); pm.expect(b.items).to.be.an(\"array\"); pm.expect(b).to.have.property(\"nextBeforeId\"); pm.expect(b.items.some(x => String(x.reviewId) === pm.collectionVariables.get(\"reviewId\"))).to.eql(true); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Reject excessive page",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/reviews/me?limit=51"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 400\", () => pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    },
    {
      "name": "Delete own review",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{baseUrl}}/api/reviews/{{reviewId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 204\", () => pm.response.to.have.status(204));",
              "pm.test(\"Empty response\", () => pm.expect(pm.response.text()).to.eql(\"\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "Own collection empty after deletion",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/reviews/me"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Empty collection\", () => pm.expect(pm.response.json()).to.eql({items:[],nextBeforeId:null}));"
            ]
          }
        }
      ]
    },
    {
      "name": "Deleted review absent",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/albums/{{albumSpotifyId}}/reviews/me"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 404\", () => pm.response.to.have.status(404));"
            ]
          }
        }
      ]
    },
    {
      "name": "Repeated deletion absent",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{baseUrl}}/api/reviews/{{reviewId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 404\", () => pm.response.to.have.status(404));"
            ]
          }
        }
      ]
    },
    {
      "name": "Reject missing authentication",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/reviews/me",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 401\", () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    }
  ]
}
