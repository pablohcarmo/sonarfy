{
  "info": {
    "name": "Sonarfy - profile",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Contract: docs/api/profiles.md. Read requests and a separate text-edit folder that MUTATES the authenticated TEST account. Run mutations individually; save previous text before editing. Images are preserved. Store accessToken locally; never export credentials. No Azure or Spotify calls. Avatar folder writes to configured TEST Azure storage. Select a local JPEG/PNG and run individually."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "targetHandle",
      "value": ""
    },
    {
      "key": "missingHandle",
      "value": "missing-test-profile"
    }
  ],
  "item": [
    {
      "name": "Read own profile",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/profile/me",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{accessToken}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"No store\", () => pm.expect(pm.response.headers.get(\"Cache-Control\")).to.include(\"no-store\"));",
              "pm.test(\"Profile fields only\", () => { const b = pm.response.json(); pm.expect(Object.keys(b).sort()).to.eql([\"identity\",\"statistics\",\"viewer\"]); pm.expect(Object.keys(b.identity).sort()).to.eql([\"avatarUrl\",\"biography\",\"coverUrl\",\"displayName\",\"handle\",\"id\",\"joinedAt\",\"location\"]); pm.expect(Object.keys(b.viewer).sort()).to.eql([\"canEdit\",\"isFollowing\",\"isSelf\"]); pm.expect(b.viewer.isFollowing).to.be.a(\"boolean\"); pm.expect(Object.keys(b.statistics).sort()).to.eql([\"followers\",\"following\"]); [b.statistics.followers,b.statistics.following].forEach(n => { pm.expect(Number.isSafeInteger(n)).to.eql(true); pm.expect(n).to.be.at.least(0); }); pm.expect(b.identity.joinedAt).to.match(/(Z|[+-][0-9]{2}:[0-9]{2})$/); });",
              "pm.test(\"Own profile\", () => { const b=pm.response.json(); pm.expect(b.viewer.isSelf).to.eql(true); pm.expect(b.viewer.canEdit).to.eql(true); pm.expect(b.viewer.isFollowing).to.eql(false); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Read another profile",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/profile/by-handle/{{targetHandle}}",
