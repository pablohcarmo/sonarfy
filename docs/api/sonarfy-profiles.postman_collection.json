    {
      "name": "Text edit - mutates TEST account",
      "description": "Use a disposable test account. Save previous text before running. Empty body object preserves fields; null clears only biography. No image mutation.",
      "item": [
        {
          "name": "Edit display name and biography",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/profile/me",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"displayName\": \"  DJ 123 🎵  \",\n  \"biography\": \"Music 🎧\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"No store\", () => pm.expect(pm.response.headers.get(\"Cache-Control\")).to.include(\"no-store\"));",
                  "pm.test(\"Profile fields only\", () => { const b = pm.response.json(); pm.expect(Object.keys(b).sort()).to.eql([\"identity\",\"statistics\",\"viewer\"]); pm.expect(Object.keys(b.identity).sort()).to.eql([\"avatarUrl\",\"biography\",\"coverUrl\",\"displayName\",\"handle\",\"id\",\"joinedAt\",\"location\"]); pm.expect(Object.keys(b.viewer).sort()).to.eql([\"canEdit\",\"isFollowing\",\"isSelf\"]); pm.expect(b.viewer.isFollowing).to.be.a(\"boolean\"); pm.expect(Object.keys(b.statistics).sort()).to.eql([\"followers\",\"following\"]); [b.statistics.followers,b.statistics.following].forEach(n => { pm.expect(Number.isSafeInteger(n)).to.eql(true); pm.expect(n).to.be.at.least(0); }); pm.expect(b.identity.joinedAt).to.match(/(Z|[+-][0-9]{2}:[0-9]{2})$/); });",
                  "pm.test(\"Normalized text and ownership\", () => { const b=pm.response.json(); pm.expect(b.identity.displayName).to.eql(\"DJ 123 \\u{1f3b5}\"); pm.expect(b.identity.biography).to.eql(\"Music \\u{1f3a7}\"); pm.expect(b.viewer.isSelf).to.eql(true); pm.expect(b.viewer.canEdit).to.eql(true); pm.expect(b.viewer.isFollowing).to.eql(false); });"
                ]
              }
            }
          ]
        },
