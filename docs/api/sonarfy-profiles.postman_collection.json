    {
      "name": "Avatar upload - mutates TEST account and storage",
      "description": "Upload accepts rectangular or square JPEG/PNG. Omit all crop fields for centered square crop; otherwise supply cropX, cropY and cropSize as integer pixels after EXIF orientation.",
      "item": [
        {
          "name": "Upload JPEG or PNG with optional crop",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/profile/me/avatar",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": []
                },
                {
                  "key": "cropX",
                  "type": "text",
                  "value": "0",
                  "disabled": true
                },
                {
                  "key": "cropY",
                  "type": "text",
                  "value": "0",
                  "disabled": true
                },
                {
                  "key": "cropSize",
                  "type": "text",
                  "value": "200",
                  "disabled": true
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Safe profile and public URL\", () => { const b=pm.response.json(); pm.expect(Object.keys(b).sort()).to.eql([\"identity\",\"statistics\",\"viewer\"]); pm.expect(b.viewer.isSelf).to.eql(true); pm.expect(b.identity.avatarUrl.startsWith(\"https://\")).to.eql(true); pm.expect(b.identity.avatarUrl).not.to.include(\"?\"); pm.collectionVariables.set(\"uploadedAvatarUrl\",b.identity.avatarUrl); });",
                  "pm.test(\"No store\", () => pm.expect(pm.response.headers.get(\"Cache-Control\")).to.include(\"no-store\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Read uploaded blob anonymously",
          "request": {
            "method": "GET",
            "url": "{{uploadedAvatarUrl}}",
            "auth": {
              "type": "noauth"
            },
            "header": []
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Public PNG\", () => { pm.response.to.have.status(200); pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"image/png\"); pm.expect(pm.response.headers.get(\"Cache-Control\")).to.include(\"immutable\"); });"
                ]
              }
            }
          ]
        },
