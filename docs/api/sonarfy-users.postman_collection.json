            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('Data preservada', () => pm.expect(pm.response.json().birthDate).to.eql('2000-02-29'));"
                ]
              }
            }
          ]
