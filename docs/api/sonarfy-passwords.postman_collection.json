{
  "info": {
    "name": "Sonarfy — autenticação, recuperação e troca de senha",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Contratos: docs/api/authentication.md e docs/api/passwords.md. Configure baseUrl, email e currentPassword para uma conta de teste ativa e verificada. Execute primeiro a pasta Autenticação HTTP: o login captura accessToken para acesso ao perfil e às rotas protegidas. As pastas de senha exigem tokens recebidos por e-mail e podem alterar a senha; execute-as separadamente, com os valores atualizados. Valores fictícios; não compartilhe credenciais ou tokens preenchidos."
  },
  "auth": {
    "type": "noauth"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "email",
      "value": "conta-teste@example.com"
    },
    {
      "key": "passwordToken",
      "value": "SUBSTITUA_PELO_TOKEN_DO_EMAIL"
    },
    {
      "key": "passwordChangeToken",
      "value": "SUBSTITUA_PELO_TOKEN_DE_AUTORIZACAO_DA_TROCA"
    },
    {
      "key": "currentPassword",
      "value": "SenhaDeTesteAtual123!"
    },
    {
      "key": "newPassword",
      "value": "SenhaDeTesteNova123!"
    }
  ],
  "item": [
    {
      "name": "Autenticação HTTP",
      "description": "Execute esta pasta com email e currentPassword de uma conta ativa e verificada. Não altera os dados da conta. O login salva accessToken; as requisições negativas substituem a autenticação explicitamente sem apagar a variável.",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.collectionVariables.unset('accessToken');"]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login retorna 200', () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) {",
                  "  const body = pm.response.json();",
                  "  pm.test('Resposta contém token Bearer com validade de 900 segundos', () => {",
                  "    pm.expect(body.accessToken).to.be.a('string').and.not.empty;",
                  "    pm.expect(body.tokenType).to.eql('Bearer');",
                  "    pm.expect(body.expiresInSeconds).to.eql(900);",
                  "  });",
                  "  if (typeof body.accessToken === 'string' && body.accessToken.length > 0) {",
                  "    pm.collectionVariables.set('accessToken', body.accessToken);",
                  "  }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {"type": "noauth"},
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"login\": \"{{email}}\",\n  \"password\": \"{{currentPassword}}\"\n}",
              "options": {"raw": {"language": "json"}}
            },
            "url": "{{baseUrl}}/api/auth/login",
            "description": "Login público. A conta precisa estar ativa e verificada. O campo login também aceita handle. Sucesso 200; credenciais inválidas ou conta indisponível retornam 401 genérico."
          }
        },
        {
          "name": "Meu perfil com Bearer",
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": [
            "pm.test('Perfil autenticado retorna 200', () => pm.response.to.have.status(200));",
            "if (pm.response.code === 200) {",
            "  const body = pm.response.json();",
            "  pm.test('Perfil corresponde ao e-mail usado no login', () => {",
            "    pm.expect(body.id).to.be.a('number').and.above(0);",
            "    pm.expect(body.email.toLowerCase()).to.eql(pm.variables.get('email').toLowerCase());",
            "  });",
            "}"
          ]}}],
          "request": {
            "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{accessToken}}", "type": "string"}]},
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/users/me",
            "description": "Execute após Login. Esperado 200 com o cadastro da conta autenticada."
          }
        },
        {
          "name": "Meu perfil sem credencial",
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": [
            "pm.test('Perfil sem credencial retorna 401', () => pm.response.to.have.status(401));"
          ]}}],
          "request": {
            "auth": {"type": "noauth"},
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/users/me",
            "description": "Esperado 401 mesmo após uma requisição autenticada: a API não mantém sessão."
          }
        },
        {
          "name": "Meu perfil com token inválido",
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": [
            "pm.test('Perfil com token inválido retorna 401', () => pm.response.to.have.status(401));"
          ]}}],
          "request": {
            "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "invalid-token", "type": "string"}]},
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/users/me",
            "description": "Esperado 401; não usa nem sobrescreve o accessToken válido da coleção."
          }
        }
      ]
    },
    {
      "name": "Recuperação pública",
      "item": [
        {
          "name": "Solicitar recuperação",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/auth/forgot-password",
            "description": "200 com resposta genérica; não confirma envio ou existência da conta."
          }
        },
        {
          "name": "Redefinir senha",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"{{passwordToken}}\",\n  \"newPassword\": \"{{newPassword}}\",\n  \"confirmNewPassword\": \"{{newPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/auth/reset-password",
            "description": "Token password_reset válido; sucesso 200. Altera a senha da conta de teste. Tokens password_change são rejeitados neste endpoint."
          }
        }
      ]
    },
    {
      "name": "Entradas inválidas — recuperação pública",
      "item": [
        {
          "name": "E-mail ausente",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/auth/forgot-password",
            "description": "Esperado 400."
          }
        },
        {
          "name": "E-mail vazio",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/auth/forgot-password",
            "description": "Esperado 400."
          }
        },
        {
          "name": "E-mail em branco",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"   \"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/auth/forgot-password",
            "description": "Esperado 400."
          }
        },
        {
          "name": "E-mail malformado",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"email-invalido\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/auth/forgot-password",
            "description": "Esperado 400."
          }
        },
        {
          "name": "Confirmação divergente",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"{{passwordToken}}\",\n  \"newPassword\": \"{{newPassword}}\",\n  \"confirmNewPassword\": \"OutraSenha123!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/auth/reset-password",
            "description": "Esperado 400; serviço verifica igualdade antes de usar o token."
          }
        }
      ]
    },
    {
      "name": "Troca autenticada",
      "description": "Execute Login antes desta pasta. As requisições herdam Bearer {{accessToken}} para estabelecer o Principal. O token passwordChangeToken, recebido por e-mail, autoriza a operação e é enviado no corpo. Após alterar a senha, atualize currentPassword antes do próximo login. Não execute esta pasta automaticamente junto da recuperação de senha.",
      "auth": {
        "type": "bearer",
        "bearer": [{"key": "token", "value": "{{accessToken}}", "type": "string"}]
      },
      "item": [
        {
          "name": "Solicitar token para troca",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/api/users/me/password-change-request",
            "description": "Sem corpo; depende de Principal autenticado. Envia token password_change. Sucesso 200, cooldown 429."
          }
        },
        {
          "name": "Alterar senha",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"{{passwordChangeToken}}\",\n  \"currentPassword\": \"{{currentPassword}}\",\n  \"newPassword\": \"{{newPassword}}\",\n  \"confirmNewPassword\": \"{{newPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/users/me/password",
            "description": "Depende de Principal autenticado e token password_change da mesma conta. Token password_reset é rejeitado. Sucesso 200."
          }
        },
        {
          "name": "Senha atual ausente",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"{{passwordToken}}\",\n  \"newPassword\": \"{{newPassword}}\",\n  \"confirmNewPassword\": \"{{newPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/users/me/password",
            "description": "Após autenticação: esperado 400. Sem autenticação a camada de segurança bloqueia antes do DTO."
          }
        }
      ]
    }
  ]
}
