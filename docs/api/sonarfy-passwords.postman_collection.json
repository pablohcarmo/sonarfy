{
  "info": {
    "name": "Sonarfy — recuperação e troca de senha",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Coleção oficial: docs/api/passwords.md. Rotas públicas disponíveis; rotas protegidas dependem da implementação de autenticação HTTP. Valores fictícios; não compartilhe tokens preenchidos."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8081"
    },
    {
      "key": "email",
      "value": "conta-teste@example.com"
    },
    {
      "key": "passwordToken",
      "value": "SUBSTITUA_PELO_TOKEN_DO_EMAIL"
    },
    {
      "key": "currentPassword",
      "value": "SenhaDeTesteAtual123!"
    },
    {
      "key": "newPassword",
      "value": "SenhaDeTesteNova123!"
    }
  ],
  "item": [
    {
      "name": "Recuperação pública",
      "item": [
        {
          "name": "Solicitar recuperação",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/auth/forgot-password",
            "description": "200 com resposta genérica; não confirma envio ou existência da conta."
          }
        },
        {
          "name": "Redefinir senha",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"{{passwordToken}}\",\n  \"newPassword\": \"{{newPassword}}\",\n  \"confirmNewPassword\": \"{{newPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/auth/reset-password",
            "description": "Token password_reset válido; sucesso 200. Altera a senha da conta de teste."
          }
        }
      ]
    },
    {
      "name": "Entradas inválidas — recuperação pública",
      "item": [
        {
          "name": "E-mail ausente",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/auth/forgot-password",
            "description": "Esperado 400."
          }
        },
        {
          "name": "E-mail vazio",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/auth/forgot-password",
            "description": "Esperado 400."
          }
        },
        {
          "name": "E-mail em branco",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"   \"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/auth/forgot-password",
            "description": "Esperado 400."
          }
        },
        {
          "name": "E-mail malformado",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"email-invalido\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/auth/forgot-password",
            "description": "Esperado 400."
          }
        },
        {
          "name": "Confirmação divergente",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"{{passwordToken}}\",\n  \"newPassword\": \"{{newPassword}}\",\n  \"confirmNewPassword\": \"OutraSenha123!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/auth/reset-password",
            "description": "Esperado 400; serviço verifica igualdade antes de usar o token."
          }
        }
      ]
    },
    {
      "name": "Troca autenticada — depende de autenticação HTTP ainda não implementada",
      "description": "O token do corpo não estabelece Principal. Não há Bearer de acesso configurado no SecurityConfig. Não executar como fluxo funcional completo até configurar autenticação HTTP.",
      "item": [
        {
          "name": "Solicitar token para troca",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/api/users/me/password-change-request",
            "description": "Sem corpo; depende de Principal autenticado. Sucesso 200, cooldown 429."
          }
        },
        {
          "name": "Alterar senha",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"{{passwordToken}}\",\n  \"currentPassword\": \"{{currentPassword}}\",\n  \"newPassword\": \"{{newPassword}}\",\n  \"confirmNewPassword\": \"{{newPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/users/me/password",
            "description": "Depende de Principal autenticado e token da mesma conta. Sucesso 200."
          }
        },
        {
          "name": "Senha atual ausente",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"{{passwordToken}}\",\n  \"newPassword\": \"{{newPassword}}\",\n  \"confirmNewPassword\": \"{{newPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/users/me/password",
            "description": "Após autenticação: esperado 400. Sem autenticação a camada de segurança bloqueia antes do DTO."
          }
        }
      ]
    }
  ]
}
