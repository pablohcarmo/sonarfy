{
  "info": {
    "name": "Sonarfy - Spotify connection",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Contract: docs/integrations/spotify.md. Run requests individually with a test account. Authorization creates state; DELETE removes credentials. Set Bearer locally and never export filled secrets. Refresh is internal, without an endpoint. Callback requires real single-use code/state. Do not run the entire collection automatically."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "spotifyCode",
      "value": ""
    },
    {
      "key": "spotifyState",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Connection",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/spotify/connection",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{accessToken}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"No store\", () => pm.expect(pm.response.headers.get(\"Cache-Control\")).to.include(\"no-store\"));",
              "pm.test(\"Public connection contract\", () => { const b = pm.response.json(); pm.expect(Object.keys(b).sort()).to.eql([\"connectedAt\", \"status\"]); pm.expect(b.status).to.be.oneOf([\"CONNECTED\", \"DISCONNECTED\", \"REAUTHORIZATION_REQUIRED\"]); if (b.status === \"DISCONNECTED\") pm.expect(b.connectedAt).to.eql(null); else pm.expect(b.connectedAt).to.be.a(\"string\"); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Authorization",
      "request": {
        "method": "POST",
        "header": [],
        "url": "{{baseUrl}}/api/spotify/authorization",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{accessToken}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"No store\", () => pm.expect(pm.response.headers.get(\"Cache-Control\")).to.include(\"no-store\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "Callback (manual)",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/spotify/callback?code={{spotifyCode}}&state={{spotifyState}}",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 302\", () => pm.response.to.have.status(302));",
              "pm.test(\"No store\", () => pm.expect(pm.response.headers.get(\"Cache-Control\")).to.include(\"no-store\"));"
            ]
          }
        }
      ],
      "protocolProfileBehavior": {
        "followRedirects": false
      }
    },
    {
      "name": "Disconnect (manual)",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{baseUrl}}/api/spotify/connection",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{accessToken}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 204\", () => pm.response.to.have.status(204));",
              "pm.test(\"No store\", () => pm.expect(pm.response.headers.get(\"Cache-Control\")).to.include(\"no-store\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "Connection without Bearer",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/spotify/connection",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 401\", () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    }
  ]
}
