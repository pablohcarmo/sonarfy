{
  "info": {
    "name": "Sonarfy - Account deactivation (TEST accounts only)",
    "description": "Requires isolated TEST accounts, migrations 010 and 016 and app.account-deactivation.enabled=true. Run folder 1, obtain the token from the TEST mailbox and set deactivationToken locally, then run folder 2. Never export credentials or tokens. See account-deactivation.md.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "noauth"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "login",
      "value": ""
    },
    {
      "key": "password",
      "value": ""
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "deactivationToken",
      "value": ""
    },
    {
      "key": "oldRefreshCookie",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1 Request",
      "item": [
        {
          "name": "Login TEST account",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/login",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Sonarfy-CSRF",
                "value": "1"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"login\":\"{{login}}\",\"password\":\"{{password}}\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('No caching', () => pm.expect(pm.response.headers.get('Cache-Control')).to.eql('no-store'));",
                  "pm.test('Access token', () => { const b=pm.response.json(); pm.expect(b.tokenType).to.eql('Bearer'); pm.expect(b.accessToken).to.be.a('string'); pm.environment.set('accessToken',b.accessToken); const c=pm.response.headers.get('Set-Cookie'); if(c) pm.environment.set('oldRefreshCookie',c.split(';')[0]); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Anonymous request",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/users/me/account-deactivation-request",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"currentPassword\":\"{{password}}\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 401', () => pm.response.to.have.status(401));",
                  "pm.test('No caching', () => pm.expect(pm.response.headers.get('Cache-Control')).to.eql('no-store'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Missing password",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/users/me/account-deactivation-request",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 400', () => pm.response.to.have.status(400));",
                  "pm.test('No caching', () => pm.expect(pm.response.headers.get('Cache-Control')).to.eql('no-store'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Accept request",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/users/me/account-deactivation-request",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"currentPassword\":\"{{password}}\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 202', () => pm.response.to.have.status(202));",
                  "pm.test('No caching', () => pm.expect(pm.response.headers.get('Cache-Control')).to.eql('no-store'));",
                  "pm.test('Accepted without secret', () => { const b=pm.response.json(); pm.expect(b).to.have.all.keys('message','expiresInSeconds'); pm.expect(b.expiresInSeconds).to.eql(900); pm.expect(pm.response.headers.has('Set-Cookie')).to.eql(false); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Cooldown",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/users/me/account-deactivation-request",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"currentPassword\":\"{{password}}\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 429', () => pm.response.to.have.status(429));",
                  "pm.test('No caching', () => pm.expect(pm.response.headers.get('Cache-Control')).to.eql('no-store'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2 Confirm",
      "item": [
        {
          "name": "Missing confirmation token",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/account-deactivation-confirmation",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer deliberately-invalid"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 400', () => pm.response.to.have.status(400));",
                  "pm.test('No caching', () => pm.expect(pm.response.headers.get('Cache-Control')).to.eql('no-store'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Confirm TEST account deactivation",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/account-deactivation-confirmation",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer deliberately-invalid"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"token\":\"{{deactivationToken}}\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 204', () => pm.response.to.have.status(204));",
                  "pm.test('No caching', () => pm.expect(pm.response.headers.get('Cache-Control')).to.eql('no-store'));",
                  "pm.test('No body or new session', () => { pm.expect(pm.response.text()).to.eql(''); pm.expect(pm.response.headers.has('Set-Cookie')).to.eql(false); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Replay confirmation",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/account-deactivation-confirmation",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"token\":\"{{deactivationToken}}\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 400', () => pm.response.to.have.status(400));",
                  "pm.test('No caching', () => pm.expect(pm.response.headers.get('Cache-Control')).to.eql('no-store'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Old access rejected",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/users/me/account-deactivation-request",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"currentPassword\":\"{{password}}\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 401', () => pm.response.to.have.status(401));",
                  "pm.test('No caching', () => pm.expect(pm.response.headers.get('Cache-Control')).to.eql('no-store'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Old refresh rejected",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/refresh",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Sonarfy-CSRF",
                "value": "1"
              },
              {
                "key": "Cookie",
                "value": "{{oldRefreshCookie}}"
              }
            ]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 401', () => pm.response.to.have.status(401));",
                  "pm.test('No caching', () => pm.expect(pm.response.headers.get('Cache-Control')).to.eql('no-store'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Normal login stays inactive",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/login",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Sonarfy-CSRF",
                "value": "1"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"login\":\"{{login}}\",\"password\":\"{{password}}\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 401', () => pm.response.to.have.status(401));",
                  "pm.test('No caching', () => pm.expect(pm.response.headers.get('Cache-Control')).to.eql('no-store'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Explicit reactivation",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/reactivation",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Sonarfy-CSRF",
                "value": "1"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"login\":\"{{login}}\",\"password\":\"{{password}}\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 204', () => pm.response.to.have.status(204));",
                  "pm.test('No caching', () => pm.expect(pm.response.headers.get('Cache-Control')).to.eql('no-store'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Old access stays rejected after reactivation",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/users/me/account-deactivation-request",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"currentPassword\":\"{{password}}\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 401', () => pm.response.to.have.status(401));",
                  "pm.test('No caching', () => pm.expect(pm.response.headers.get('Cache-Control')).to.eql('no-store'));"
                ]
              }
            }
          ]
        },
        {
          "name": "New login",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/login",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Sonarfy-CSRF",
                "value": "1"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"login\":\"{{login}}\",\"password\":\"{{password}}\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('No caching', () => pm.expect(pm.response.headers.get('Cache-Control')).to.eql('no-store'));",
                  "pm.test('Access token', () => { const b=pm.response.json(); pm.expect(b.tokenType).to.eql('Bearer'); pm.expect(b.accessToken).to.be.a('string'); pm.environment.set('accessToken',b.accessToken); const c=pm.response.headers.get('Set-Cookie'); if(c) pm.environment.set('oldRefreshCookie',c.split(';')[0]); });"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
